{
  "name": "rebind",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Pokémon TCG binder collections",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run generate -w @rebind/db",
    "db:migrate": "npm run migrate -w @rebind/db",
    "db:migrate:deploy": "npm run migrate:deploy -w @rebind/db",
    "db:studio": "npm run studio -w @rebind/db"
  },
  "engines": {
    "node": ">=20"
  }
}
