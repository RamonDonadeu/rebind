# =============================================================================
# ReBind — copy to .env for local development
# =============================================================================

# --- App ---
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://api:4000
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_USER=rebind
POSTGRES_PASSWORD=rebind
POSTGRES_DB=rebind
DATABASE_URL=postgresql://rebind:rebind@postgres:5432/rebind

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth (change in production) ---
JWT_SECRET=dev-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Stripe (Phase 4 — optional) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_COLLECTOR_MONTHLY=
# STRIPE_PRICE_COLLECTOR_YEARLY=

# --- TCGdex ---
TCGDEX_LANG=en
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
